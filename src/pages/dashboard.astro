---
import Layout from "@/layouts/Layout.astro";

const { supabase, user } = Astro.locals;

let surveyCompleted: boolean | null = null;

if (supabase && user) {
  const { data, error } = await supabase.from("profiles").select("survey_completed_at").eq("id", user.id).maybeSingle();

  if (!error && data) {
    surveyCompleted = data.survey_completed_at !== null;
  }
}

const surveyLinkLabel =
  surveyCompleted === null
    ? "Open your training survey"
    : surveyCompleted
      ? "Edit your training survey"
      : "Fill in your training survey";
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {surveyCompleted === false && (
        <p class="mt-3 text-sm text-blue-100/70">
          Answer nine quick questions so HomeFit can build your training week.
        </p>
      )}
      <a
        href="/survey"
        class:list={[
          "mt-6 inline-block rounded-lg border px-4 py-2 text-sm transition-colors",
          surveyCompleted === false
            ? "border-purple-300/40 bg-purple-500/30 text-white hover:bg-purple-500/45"
            : "border-white/20 bg-white/10 hover:bg-white/20",
        ]}
      >
        {surveyLinkLabel}
      </a>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
