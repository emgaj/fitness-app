{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-fit",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
